# ── Raw data and large binaries ───────────────────────────────────────────────
data/
embeddings/
checkpoints/
documentation/

# ── Pipeline-generated artifacts (1.1 GB, regeneratable via run_pipeline.py) ──
artifacts/

# ── Executed notebooks (regeneratable) ────────────────────────────────────────
executed/

# ── Runtime logs ──────────────────────────────────────────────────────────────
logs/
*.log

# ── Generated figures (regeneratable by analysis notebooks) ───────────────────
results/

# ── LaTeX build artifacts (all subdirectories) ────────────────────────────────
latex/**/*.aux
latex/**/*.bbl
latex/**/*.blg
latex/**/*.fdb_latexmk
latex/**/*.fls
latex/**/*.lof
latex/**/*.log
latex/**/*.lot
latex/**/*.out
latex/**/*.pdf
latex/**/*.synctex.gz
latex/**/*.toc
latex/**/texput.log

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Auto-generated review and result notes ────────────────────────────────────
REVIEW.md
pipeline_results_*.md
